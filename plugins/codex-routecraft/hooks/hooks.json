{
  "description": "RouteCraft lifecycle guard for GitHub source-of-truth and explicit Memory Loop closure.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routecraft_source_guard.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/routecraft_source_guard.py\"",
            "statusMessage": "Checking RouteCraft source and Memory policies",
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routecraft_source_guard.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/routecraft_source_guard.py\"",
            "statusMessage": "Confirming source sync and Memory Loop closure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
